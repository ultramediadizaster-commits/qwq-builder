rules_version = '2';
// QWQ Builder: әр пайдаланушы тек өз users/{uid}/builderChats құжаттарын оқып-жаза алады. Қалғанының бәріне тыйым.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validChat(chatId) {
      let d = request.resource.data;
      return d.id == chatId
        && d.updated is number
        && !d.keys().hasAny(['accessKey', 'apiKey', 'token', 'github_token', 'secret', 'password']);
    }

    match /users/{uid}/builderChats/{chatId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validChat(chatId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
