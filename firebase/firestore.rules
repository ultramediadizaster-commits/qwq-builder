rules_version = '2';
// QWQ Builder:
//  · users/{uid}/builderChats, users/{uid}/builderMeta — әр пайдаланушы тек өз құжаттарын оқып-жаза алады.
//  · gallery, galleryCode — ортақ галерея: оқу — бәріне; жариялау — тек Google арқылы кіргендерге (өз uid-імен); өшіру — тек иесіне; өзгерту жоқ.
//  · қалғанының бәріне тыйым.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function isGoogle() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function validChat(chatId) {
      let d = request.resource.data;
      return d.id == chatId
        && d.updated is number
        && !d.keys().hasAny(['accessKey', 'apiKey', 'token', 'github_token', 'secret', 'password']);
    }

    match /users/{uid}/builderChats/{chatId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validChat(chatId);
    }

    // қолданушы баптаулары (мысалы, нұсқаулық көрілді ме): тек иесі
    match /users/{uid}/builderMeta/{doc} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && request.resource.data.keys().hasOnly(['tourDone', 'at'])
        && request.resource.data.tourDone is bool && request.resource.data.at is number;
      allow delete: if isOwner(uid);
    }

    // карточка: метадеректер + кіші сурет (тізім жеңіл болу үшін)
    match /gallery/{id} {
      allow read: if true;
      allow create: if isGoogle()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'title', 'desc', 'thumb', 'created', 'size'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.desc is string && request.resource.data.desc.size() <= 300
        && request.resource.data.thumb is string && request.resource.data.thumb.size() <= 60000
        && request.resource.data.created is number
        && request.resource.data.size is number && request.resource.data.size <= 900000;
      allow update: if false;
      allow delete: if isOwner(resource.data.uid);
    }

    // қосымшаның HTML-і (≤ 900 000 таңба: Firestore құжаты ~1 МиБ-тан аспауы керек)
    match /galleryCode/{id} {
      allow read: if true;
      allow create: if isGoogle()
        && request.resource.data.keys().hasOnly(['uid', 'html'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.html is string && request.resource.data.html.size() > 20 && request.resource.data.html.size() <= 900000
        && getAfter(/databases/$(database)/documents/gallery/$(id)).data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isOwner(resource.data.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
